# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional
## Path to the SQLite database file. The parent directory is created on startup.
DATABASE_PATH=./data/lfcbot.db
## The guild (server) ID to register commands to during development.
## For example: 123456789012345678. When empty, commands are registered globally.
DISCORD_GUILD_ID=
## The application environment: development or production.
NODE_ENV=development
## Log level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
## Mana Pool API access token (mpat_...), used to link listings to their exact
## printing on manapool.com. Optional: without it, listings fall back to a
## locally-built link (or no link, if the set/collector number aren't known).
MANAPOOL_API_KEY=
## Port for the GET /health check endpoint used by the Dockerfile HEALTHCHECK
## and docker-compose healthcheck.
HEALTH_PORT=3000
## Discord webhook URL to receive critical error alerts (fatal startup
## errors, unhandled interaction errors, total digest delivery failures).
## Optional: leave empty to disable alerting.
DISCORD_ALERT_WEBHOOK_URL=
