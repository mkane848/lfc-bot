# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional
## Path to the SQLite database file. The parent directory is created on startup.
DATABASE_PATH=./data/lfcbot.db
## The guild (server) ID to register commands to during development.
## For example: 123456789012345678. When empty, commands are registered globally.
DISCORD_GUILD_ID=
## The application environment: development or production.
NODE_ENV=development
## Log level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
## Mana Pool API access token (mpat_...), used to link listings to their
## product page on manapool.com: an exact printing for a card listing, or the
## matched product for a sealed listing. Optional: without it, card listings
## fall back to a locally-built link (or no link, if the set/collector number
## aren't known), and sealed listings get no link at all.
MANAPOOL_API_KEY=
## Port for the GET /health check endpoint used by the Dockerfile HEALTHCHECK
## and docker-compose healthcheck.
HEALTH_PORT=3000
## Discord webhook URL to receive critical error alerts (fatal startup
## errors, unhandled interaction errors, total digest delivery failures).
## Optional: leave empty to disable alerting.
DISCORD_ALERT_WEBHOOK_URL=

# Docker Compose (prebuilt image only)
## Uncomment to run the prebuilt GHCR image instead of building from source.
## Required by scripts/auto-update-prebuilt.sh; see docs/DEPLOYMENT.md.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prebuilt.yml
## Pin a release tag instead of tracking :latest (tags carry a v prefix).
# LFCBOT_IMAGE=ghcr.io/mkane848/lfc-bot:v1.6.0
