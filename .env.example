# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional
## Path to the SQLite database file. The parent directory is created on startup.
DATABASE_PATH=./data/lfcbot.db
## Comma-separated guild IDs to register commands to during development.
## When empty, commands are registered globally.
DISCORD_GUILD_ID=
## The application environment: development or production.
NODE_ENV=development
## Log level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
